<script>
const lessons=[
 {grade:4,emoji:"👋",topic:"Salam",word:"Assalamu alaikum",meaning:"Salam pembuka yang digunakan dalam pergaulan sehari-hari."},
 {grade:4,emoji:"🙏",topic:"Ungkapan",word:"Kurru sumanga’",meaning:"Ungkapan terima kasih; bentuk dan konteksnya perlu diverifikasi oleh guru lokal."},
 {grade:4,emoji:"👩‍👧",topic:"Keluarga",word:"Amma’",meaning:"Ibu; penggunaan dapat berbeda menurut konteks keluarga."},
 {grade:4,emoji:"👨",topic:"Keluarga",word:"Bapa’",meaning:"Ayah; variasi ejaan/pengucapan dapat ditemukan."},
 {grade:4,emoji:"🏠",topic:"Tempat",word:"Balla’",meaning:"Rumah."},
 {grade:4,emoji:"💧",topic:"Benda",word:"Je’ne",meaning:"Air."},
 {grade:4,emoji:"🍚",topic:"Makanan",word:"Kanre",meaning:"Makanan/nasi, bergantung konteks."},
 {grade:4,emoji:"😊",topic:"Sapaan",word:"Apa kareba?",meaning:"Sapaan yang menanyakan kabar; penggunaan dapat dipengaruhi ragam lokal."},
 {grade:5,emoji:"🏫",topic:"Sekolah",word:"Sikola",meaning:"Sekolah; pelajari pemakaian kata dalam kalimat bersama guru."},
 {grade:5,emoji:"📚",topic:"Benda",word:"Buku",meaning:"Buku; bandingkan kata serapan dan penggunaan sehari-hari."},
 {grade:5,emoji:"👫",topic:"Pertemanan",word:"Sikali’basa",meaning:"Contoh ungkapan terkait kebersamaan; mohon validasi penutur lokal sebelum diajarkan."},
 {grade:5,emoji:"🌳",topic:"Lingkungan",word:"Tangke",meaning:"Cabang/ranting dalam sejumlah penggunaan; verifikasi ragam setempat."},
 {grade:5,emoji:"🌞",topic:"Alam",word:"Allo",meaning:"Hari/matahari, bergantung konteks."},
 {grade:5,emoji:"🌙",topic:"Alam",word:"Bulan",meaning:"Bulan; makna dan bentuk dapat mengikuti konteks kalimat."},
 {grade:5,emoji:"🐟",topic:"Hewan",word:"Juku’",meaning:"Ikan."},
 {grade:5,emoji:"🐔",topic:"Hewan",word:"Manu’",meaning:"Ayam."},
 {grade:6,emoji:"🗣️",topic:"Percakapan",word:"Apa kareba?",meaning:"Sapaan untuk menanyakan kabar; latih dialog dua arah."},
 {grade:6,emoji:"🤝",topic:"Sopan santun",word:"Tabe’",meaning:"Ungkapan santun saat meminta izin atau lewat; perhatikan konteks."},
 {grade:6,emoji:"💛",topic:"Nilai budaya",word:"Sipakatau",meaning:"Saling memanusiakan dan menghargai sesama."},
 {grade:6,emoji:"🧭",topic:"Nilai budaya",word:"Sipakainga’",meaning:"Saling mengingatkan dalam kebaikan."},
 {grade:6,emoji:"🌱",topic:"Nilai budaya",word:"Sikatutui",meaning:"Saling menjaga; cocok dibahas sebagai nilai kebersamaan setempat."},
 {grade:6,emoji:"🎭",topic:"Budaya",word:"Kelong",meaning:"Lagu/nyanyian tradisional; kenali contoh melalui guru atau pelaku budaya."},
 {grade:6,emoji:"🥁",topic:"Seni",word:"Gandrang",meaning:"Gendang dalam tradisi seni Sulawesi Selatan."},
 {grade:6,emoji:"🏡",topic:"Lingkungan",word:"Balla’",meaning:"Rumah; gunakan dalam percakapan sederhana tentang tempat tinggal."}
];
let selectedGrade=4, selectedAudioGrade=4;
const gradeDescriptions={4:'Kelas 4: kosakata dasar, salam, keluarga, benda, dan lingkungan sekitar.',5:'Kelas 5: kosakata sekolah, hewan, alam, dan percakapan sederhana.',6:'Kelas 6: percakapan, sopan santun, nilai budaya, dan seni tradisional.'};
function renderLessons(){const items=lessons.filter(x=>x.grade===selectedGrade);lessonCards.innerHTML=items.map(x=>`<article class="lesson"><div class="picture">${x.emoji}</div><div class="meaning">Kelas ${x.grade} • ${x.topic}</div><h3 class="word">${x.word}</h3><div class="meaning">${x.meaning}</div><button class="action say" data-say="${x.word.replaceAll('"','&quot;')}">🔊 Dengarkan</button></article>`).join('');document.getElementById('gradeDescription').textContent=gradeDescriptions[selectedGrade];document.querySelectorAll('[data-grade]').forEach(b=>b.classList.toggle('active',Number(b.dataset.grade)===selectedGrade));}
function renderAudio(){const items=lessons.filter(x=>x.grade===selectedAudioGrade);document.getElementById('audioCards').innerHTML=items.map(x=>`<article class="lesson"><div class="picture">${x.emoji}</div><div class="meaning">Kelas ${x.grade} • ${x.topic}</div><h3>${x.word}</h3><button class="action say" data-say="${x.word.replaceAll('"','&quot;')}">▶ Putar suara</button></article>`).join('');document.querySelectorAll('[data-audio-grade]').forEach(b=>b.classList.toggle('active',Number(b.dataset.audioGrade)===selectedAudioGrade));}
const lessonCards=document.getElementById('lessonCards');
renderLessons();renderAudio();
document.querySelectorAll('[data-grade]').forEach(b=>b.addEventListener('click',()=>{selectedGrade=Number(b.dataset.grade);renderLessons();}));
document.querySelectorAll('[data-audio-grade]').forEach(b=>b.addEventListener('click',()=>{selectedAudioGrade=Number(b.dataset.audioGrade);renderAudio();}));
function speak(text){if(!('speechSynthesis'in window)){alert('Browser ini belum mendukung fitur suara.');return;}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='id-ID';u.rate=.82;u.pitch=1; speechSynthesis.speak(u);}
document.addEventListener('click',e=>{const s=e.target.closest('[data-say]');if(s)speak(s.dataset.say);});
const questions=[
 {q:"Apa arti kata “Balla’” pada materi?",o:["Rumah","Air","Makanan","Ayah"],a:0},
 {q:"Kata “Je’ne” berkaitan dengan benda apa?",o:["Buku","Air","Rumah","Pintu"],a:1},
 {q:"Ungkapan “Assalamu alaikum” biasa digunakan sebagai …",o:["Salam pembuka","Nama tempat","Nama makanan","Ucapan tidur"],a:0},
 {q:"Kata “Amma’” pada contoh materi merujuk kepada …",o:["Kakak","Ayah","Ibu","Teman"],a:2},
 {q:"Apa yang sebaiknya dilakukan jika ragu terhadap arti atau pelafalan kosakata daerah?",o:["Menebak saja","Memeriksa dengan guru/penutur lokal","Menghapus semua materi","Mengabaikannya"],a:1},
 {q:"Video pembelajaran pada menu Video Belajar dibuka melalui …",o:["Kalkulator","YouTube","Kamera saja","Galeri foto"],a:1},
 {q:"Fitur Periksa Nilai digunakan untuk …",o:["Mengganti nama sekolah","Menghitung hasil kuis","Memutar video","Mengubah warna"],a:1},
 {q:"Aplikasi ini dibuat untuk mendukung pembelajaran di …",o:["UPT SDN 10 Turatea","Rumah sakit","Terminal","Pasar"],a:0},
 {q:"Tekan tombol Dengarkan untuk …",o:["Mencetak lembar","Mendengar pembacaan kata","Menghapus soal","Menutup aplikasi"],a:1},
 {q:"Materi Bahasa Makassar pada aplikasi ini sebaiknya …",o:["Tidak pernah diperiksa","Diverifikasi dengan guru/penutur lokal","Dianggap kamus resmi","Diganti semua dengan bahasa asing"],a:1}
];
const quizForm=document.getElementById('quizForm');
function renderQuiz(){quizForm.innerHTML=questions.map((q,i)=>`<div class="quiz-question"><h3>${i+1}. ${q.q}</h3>${q.o.map((o,j)=>`<label class="opt"><input type="radio" name="q${i}" value="${j}"> ${String.fromCharCode(65+j)}. ${o}</label>`).join('')}</div>`).join('');document.getElementById('quizResult').innerHTML='';}
renderQuiz();
document.getElementById('checkQuiz').addEventListener('click',()=>{let score=0,answered=0;questions.forEach((q,i)=>{const a=quizForm.querySelector(`input[name="q${i}"]:checked`);if(a){answered++;if(Number(a.value)===q.a)score++;}});const percent=Math.round(score/questions.length*100);document.getElementById('quizResult').innerHTML=`<div class="result">Nilai kamu: ${percent}/100<br>Jawaban benar: ${score} dari ${questions.length}<br>Soal dijawab: ${answered} dari ${questions.length}<br>${percent>=80?'Hebat! Terus pertahankan! 🌟':percent>=60?'Bagus, ayo belajar lagi! 💪':'Jangan menyerah, pelajari materi lalu coba lagi! 📚'}</div>`;});
document.getElementById('retryQuiz').addEventListener('click',renderQuiz);
function show(id){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.getElementById('homeScreen').style.display=id?'none':'';if(id){document.getElementById(id)?.classList.add('active');document.getElementById(id)?.scrollIntoView({behavior:'smooth',block:'start'});}else window.scrollTo({top:0,behavior:'smooth'});}
document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>show(b.dataset.open)));
document.querySelectorAll('[data-home]').forEach(b=>b.addEventListener('click',()=>show(null)));
document.getElementById('year').textContent=new Date().getFullYear();
let installPrompt=null;const installBtn=document.getElementById('installBtn');
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();installPrompt=e;installBtn.classList.add('show');});
installBtn.addEventListener('click',async()=>{if(!installPrompt){alert('Jika tombol instal belum tersedia, buka menu ⋮ Chrome lalu pilih Tambahkan ke layar utama.');return;}installPrompt.prompt();await installPrompt.userChoice;installPrompt=null;installBtn.classList.remove('show');});
if('serviceWorker'in navigator && location.protocol.startsWith('http'))window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(console.warn));
</script>
